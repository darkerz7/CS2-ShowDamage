.sd-root
{
	width: 100%;
	height: 100%;
}

.sd-class-hide
{
	visibility: collapse;
}

#sd-panel
{
	align: center center;
	width: 20%;
	height: width-percentage(100%);
}

.sd-text
{
	width: auto;
	height: auto;
	align: center center;
	text-align: center;
	overflow: noclip;
	white-space: nowrap;
	font-family: Stratum2, 'Arial Unicode MS';
	font-stretch: semi-condensed;
	font-weight: bold;
	text-shadow: 1px 1px 2px 2 rgba(0, 0, 0, 0.65);
	font-size: 22px;
	position: absolute;
	opacity: 0.7;
	transition-property: margin-left, margin-top, opacity;
	transition-duration: 0.12s;
}

.sd-text-damage
{
	color: #00ffff;
}

.sd-text-self-damage
{
	color: #ff0000;
	margin-top: 50%;
}

.sd-class-position-0  { margin-left: -50%;  margin-top: 0%; }
.sd-class-position-1  { margin-left: -49%;  margin-top: -9%; }
